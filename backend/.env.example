# Gemini API Key (Google AI Studio). Server-side only; never put this in the app.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.1-flash-lite)
GEMINI_MODEL=

# Upstash Redis for rate limiting (set automatically by the Vercel integration).
# If unreachable, the API falls back to a per-instance in-memory limit.
KV_REST_API_URL=
KV_REST_API_TOKEN=
